# ═══════════════════════════════════════════════════════════════════════════
# SnapSphere — backend environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DB_NAME=snapsphere
DB_USER=snapsphere
DB_PASSWORD=snapsphere
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Redis (0 = cache, 1 = celery broker, 2 = channels) ──────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=14

# ─── CORS (admin web dashboard + Expo dev server) ────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# ─── Email (dev prints to console) ───────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@snapsphere.pk

# ─── Business rules (overridable without code changes) ───────────────────────
BOOKING_EXPIRY_HOURS=48
BOOKING_MIN_LEAD_HOURS=24
PLATFORM_COMMISSION_PERCENT=10
MAX_PENDING_BOOKINGS_PER_BUYER=5

# ─── ML ──────────────────────────────────────────────────────────────────────
ML_ARTIFACTS_DIR=../ml/artifacts
REC_WEIGHT_CONTENT=0.55
REC_WEIGHT_COLLAB=0.30
REC_WEIGHT_BUSINESS=0.15
